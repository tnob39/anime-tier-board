AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Native(モバイル)アプリ向けBearer tokenの署名用。AUTH_SECRETとは別の値を設定する（Web/Nativeの署名鍵を分離するため）。
NATIVE_AUTH_SECRET=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
AUTH_URL=https://anime-tier-board.vercel.app
AUTH_TRUST_HOST=true
TMDB_API_KEY=
TMDB_BEARER_TOKEN=
# Vercel Cron(/api/cron/notify, /api/cron/feedback-to-issues)からの呼び出しを認証するBearer token。未設定だとリクエストを拒否する。
CRON_SECRET=
# 匿名フィードバック画像の保存先 (Vercel Blob)。未設定だと画像付き投稿は失敗する。
BLOB_READ_WRITE_TOKEN=
# フィードバックを GitHub Issue 化する fine-grained token (Issues: write のみ推奨)。
GITHUB_FEEDBACK_TOKEN=
# Issue 作成先リポジトリ (owner/repo)。例: tnob39/anime-tier-board
GITHUB_FEEDBACK_REPO=tnob39/anime-tier-board
